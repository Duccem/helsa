# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# @type=string(minLength=1)
DATABASE_URL=

# @type=string
GOOGLE_CLIENT_ID=

# @type=string
GOOGLE_CLIENT_SECRET=

# Master key for clinical data (notes, intake reason, files). Generate with `openssl rand -base64 32`.
# Losing it makes existing clinical data unreadable.
# @required=false @type=string(minLength=32)
CLINICAL_ENCRYPTION_KEY=

# Supabase project URL, for file storage.
# @required=false @type=url
SUPABASE_URL=

# Supabase service role key. Server only: never expose it to the browser.
# @required=false @type=string
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket that holds patient files.
# @required=false @sensitive=false @type=string
SUPABASE_STORAGE_BUCKET=patient-files

# Jitsi server for video sessions (see docker/jitsi). Locally: https://localhost:8443
# @required=false @sensitive=false @type=url
JITSI_URL=

# JWT issuer shared with Jitsi (JWT_APP_ID in docker/jitsi/.env).
# @required=false @sensitive=false @type=string
JITSI_APP_ID=helsa

# JWT audience accepted by Jitsi (JWT_ACCEPTED_AUDIENCES in docker/jitsi/.env).
# @required=false @sensitive=false @type=string
JITSI_AUDIENCE=helsa-video

# Secret used to sign Jitsi tokens (JWT_APP_SECRET in docker/jitsi/.env). Server only.
# @required=false @type=string(minLength=32)
JITSI_APP_SECRET=
