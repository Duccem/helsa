# Copy to .env and fill in the secrets. Never commit .env.

# Jitsi image tag (https://github.com/jitsi/docker-jitsi-meet/releases)
JITSI_IMAGE_VERSION=stable-11248-2

# Where Jitsi writes its generated config. Delete this folder after changing auth settings.
CONFIG=./.jitsi-meet-cfg

TZ=UTC
HTTP_PORT=8000
HTTPS_PORT=8443
PUBLIC_URL=https://localhost:8443

# Media. Add your LAN IP (e.g. 127.0.0.1,192.168.1.20) to join from a phone on the same network.
JVB_PORT=10000
JVB_ADVERTISE_IPS=127.0.0.1

# JWT shared with Helsa (apps/web/.env: JITSI_APP_ID / JITSI_APP_SECRET).
# Token claims must be: iss=JWT_APP_ID, aud=JWT_ACCEPTED_AUDIENCES, sub=meet.jitsi
# Generate the secret with: openssl rand -hex 32
JWT_APP_ID=helsa
JWT_APP_SECRET=
JWT_ACCEPTED_ISSUERS=helsa
JWT_ACCEPTED_AUDIENCES=helsa-video

# Optional: page a guest is sent to when clicking "I am the host" (Helsa login)
TOKEN_AUTH_URL=

# Internal XMPP passwords. Generate each with: openssl rand -hex 16
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
